          <% end %>
        </div>
        <p class="mt-4" style="opacity: 0.9;">✨ <strong>100% Safe & Secure</strong> • Verified Profiles • Privacy First</p>
      </div>

      <!-- Right Side - Features Section -->
      <div class="col-lg-6" style="animation: slideInRight 0.8s ease-out;">
        <div class="card shadow-lg border-0 rounded-4" style="background: rgba(255,255,255,0.98); backdrop-filter: blur(10px);">
          <div class="card-body p-5">
            <h4 class="card-title mb-4" style="color: #667eea; font-size: 1.5rem; font-weight: bold;">✨ Why Choose Us?</h4>
            
            <div style="margin-bottom: 20px;">
              <h6 style="color: #e85d75; font-weight: bold; margin-bottom: 8px;">💯 Verified Profiles</h6>
              <p style="color: #666; font-size: 14px; margin: 0;">All members are verified for authenticity</p>
            </div>

            <div style="margin-bottom: 20px;">
              <h6 style="color: #e85d75; font-weight: bold; margin-bottom: 8px;">🔒 100% Privacy</h6>
              <p style="color: #666; font-size: 14px; margin: 0;">Your data is safe and secure with us</p>
            </div>

            <div style="margin-bottom: 20px;">
              <h6 style="color: #e85d75; font-weight: bold; margin-bottom: 8px;">🎯 AI Matching</h6>
              <p style="color: #666; font-size: 14px; margin: 0;">Smart matching algorithm finds your perfect match</p>
            </div>

            <div style="margin-bottom: 20px;">
              <h6 style="color: #e85d75; font-weight: bold; margin-bottom: 8px;">💬 24/7 Support</h6>
              <p style="color: #666; font-size: 14px; margin: 0;">Our team is here to help you anytime</p>
            </div>

            <hr>

            <div style="text-align: center; margin-top: 20px;">
              <p style="color: #999; font-size: 13px; margin-bottom: 12px;">Join over <strong style="color: #e85d75;">50,000+ couples</strong> who found love!</p>
              <a href="<%= new_signup_path %>" class="btn btn-lg fw-bold px-4" style="background: linear-gradient(135deg, #e85d75 0%, #f54a8b 100%); border: none; border-radius: 10px; color: white;">
                Start Your Journey →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(30px); }
    }
    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-50px); }
      to { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideInRight {
      from { opacity: 0; transform: translateX(50px); }
      to { opacity: 1; transform: translateX(0); }
    }
  </style>
</section>

