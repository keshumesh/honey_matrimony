<!-- Login Modal Popup on Home Page -->
<div class="modal fade" id="loginModal" tabindex="-1" role="dialog" aria-labelledby="loginLabel" aria-hidden="true" style="z-index: 9999;">
  <div class="modal-dialog modal-dialog-centered" role="document" style="max-width: 480px;">
    <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
      <!-- Gradient Header with Close Button -->
      <div style="background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #ff6b9d 50%, #ee7a52 100%); padding: 30px; position: relative; overflow: hidden; display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
          <h2 class="text-white fw-bold mb-2" style="font-size: 1.8rem; text-shadow: 2px 2px 8px rgba(0,0,0,0.2);">
            Welcome Back! 💕
          </h2>
          <p class="text-white opacity-90 mb-0" style="font-size: 0.9rem;">
            Login to find your perfect match
          </p>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" style="position: relative; top: -5px;"></button>
      </div>

      <!-- Modal Body -->
      <div class="modal-body p-4">
        <!-- Login Type Tabs -->
        <ul class="nav nav-pills nav-fill mb-4" id="loginTabs" role="tablist" style="gap: 10px;">
          <li class="nav-item" role="presentation" style="flex: 1;">
            <button class="nav-link active w-100" id="email-tab" data-bs-toggle="pill" data-bs-target="#emailLogin" type="button" role="tab" style="border-radius: 10px; color: #667eea; border: 2px solid #667eea; background: transparent;">
              <i class="bi bi-envelope me-2"></i>Email
            </button>
          </li>
          <li class="nav-item" role="presentation" style="flex: 1;">
            <button class="nav-link w-100" id="mobile-tab" data-bs-toggle="pill" data-bs-target="#mobileLogin" type="button" role="tab" style="border-radius: 10px; color: #667eea; border: 2px solid #667eea; background: transparent;">
              <i class="bi bi-phone me-2"></i>Mobile
            </button>
          </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content" id="loginTabContent">
          <!-- Email Login Tab -->
          <div class="tab-pane fade show active" id="emailLogin" role="tabpanel">
            <%= form_with url: sessions_path, method: :post, local: true do |form| %>
              <%= form.hidden_field :login_type, value: "email" %>
              
              <div class="mb-4">
                <label class="form-label fw-bold" style="color: #667eea;">
                  <i class="bi bi-envelope me-2" style="color: #ff6b9d;"></i>Email Address
                </label>
                <%= form.email_field :email, class: "form-control form-control-lg", placeholder: "Enter your email", style: "border-radius: 10px; border: 2px solid #e0e0e0; padding: 12px 15px;" %>
              </div>

              <div class="mb-4">
                <label class="form-label fw-bold" style="color: #667eea;">
                  <i class="bi bi-lock me-2" style="color: #4CAF50;"></i>Password
                </label>
                <%= form.password_field :password, class: "form-control form-control-lg", placeholder: "Enter your password", style: "border-radius: 10px; border: 2px solid #e0e0e0; padding: 12px 15px;" %>
              </div>

              <div class="mb-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="rememberMeEmail" style="width: 18px; height: 18px; cursor: pointer;">
                  <label class="form-check-label" for="rememberMeEmail" style="color: #666; cursor: pointer;">Remember me</label>
                </div>
              </div>

              <div class="d-grid gap-2 mb-3">
                <%= form.submit "Login with Email", class: "btn btn-lg fw-bold", style: "background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #ff6b9d 100%); border: none; border-radius: 10px; color: white; padding: 14px; font-size: 1rem;" %>
              </div>
            <% end %>
          </div>

          <!-- Mobile Login Tab -->
          <div class="tab-pane fade" id="mobileLogin" role="tabpanel">
            <%= form_with url: sessions_path, method: :post, local: true do |form| %>
              <%= form.hidden_field :login_type, value: "mobile" %>
              
              <div class="mb-4">
                <label class="form-label fw-bold" style="color: #667eea;">
                  <i class="bi bi-phone me-2" style="color: #ff6b9d;"></i>Mobile Number
                </label>
                <%= form.text_field :mobile_no, class: "form-control form-control-lg", placeholder: "Enter your 10-digit mobile number", pattern: "\\d{10}", style: "border-radius: 10px; border: 2px solid #e0e0e0; padding: 12px 15px;" %>
                <small class="text-muted">Format: 10 digits without +91</small>
              </div>

              <div class="mb-4">
                <label class="form-label fw-bold" style="color: #667eea;">
                  <i class="bi bi-lock me-2" style="color: #4CAF50;"></i>Password
                </label>
                <%= form.password_field :password, class: "form-control form-control-lg", placeholder: "Enter your password", style: "border-radius: 10px; border: 2px solid #e0e0e0; padding: 12px 15px;" %>
              </div>

              <div class="mb-4">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="rememberMeMobile" style="width: 18px; height: 18px; cursor: pointer;">
                  <label class="form-check-label" for="rememberMeMobile" style="color: #666; cursor: pointer;">Remember me</label>
                </div>
              </div>

              <div class="d-grid gap-2 mb-3">
                <%= form.submit "Login with Mobile", class: "btn btn-lg fw-bold", style: "background: linear-gradient(135deg, #667eea 0%, #764ba2 50%, #ff6b9d 100%); border: none; border-radius: 10px; color: white; padding: 14px; font-size: 1rem;" %>
              </div>
            <% end %>
          </div>
        </div>

        <!-- OR Divider -->
        <div class="d-flex align-items-center my-4">
          <div style="flex: 1; height: 1px; background: #ddd;"></div>
          <span class="px-3" style="color: #999; font-size: 0.9rem;">Quick Login</span>
          <div style="flex: 1; height: 1px; background: #ddd;"></div>
        </div>

        <!-- Social Login Buttons -->
        <div class="d-grid gap-2 mb-3">
          <a href="/auth/google_oauth2" class="btn btn-lg fw-bold" style="background: #ffffff; border: 2px solid #f0f0f0; border-radius: 10px; color: #333; padding: 12px;">
            <i class="bi bi-google me-2" style="color: #4285F4;"></i>Login with Google
          </a>
          <a href="/auth/facebook" class="btn btn-lg fw-bold" style="background: #ffffff; border: 2px solid #f0f0f0; border-radius: 10px; color: #333; padding: 12px;">
            <i class="bi bi-facebook me-2" style="color: #1877F2;"></i>Login with Facebook
          </a>
        </div>

        <!-- OR Divider -->
        <div class="d-flex align-items-center my-3">
          <div style="flex: 1; height: 1px; background: #ddd;"></div>
          <span class="px-3" style="color: #999; font-size: 0.9rem;">OR</span>
          <div style="flex: 1; height: 1px; background: #ddd;"></div>
        </div>

        <!-- Sign Up Link -->
        <div class="text-center">
          <p class="mb-2" style="color: #666;">Don't have an account?</p>
          <a href="<%= new_user_path %>" class="btn btn-outline-primary w-100" style="border-radius: 10px; color: #667eea; border-color: #667eea; border-width: 2px;">Sign up free</a>
        </div>

        <p class="text-center small mt-3" style="color: #999;">
          <i class="bi bi-shield-check" style="color: #4CAF50;"></i> Safe & Secure • No spam
        </p>
      </div>
    </div>
  </div>
</div>

<!-- Initialize Modal with jQuery/Bootstrap -->
<script>
<!-- Initialize Login Modal -->
<script>
  // Function to show login modal
  function showLoginModal() {
    const modalElement = document.getElementById('loginModal');
    if (typeof bootstrap !== 'undefined' && modalElement) {
      try {
        const modal = new bootstrap.Modal(modalElement);
        modal.show();
      } catch (err) {
        console.error('Error showing modal:', err);
      }
    }
  }

  // Initialize modal trigger on page load
  document.addEventListener('DOMContentLoaded', function() {
    const modalElement = document.getElementById('loginModal');
    const btn = document.getElementById('loginModalBtn');
    
    if (btn && modalElement) {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        showLoginModal();
      });
    }
  });
</script>

<style>
  .form-control:focus,
  .form-control:active {
    border-color: #667eea !important;
    box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25) !important;
  }

  .form-control::placeholder {
    color: #bbb;
    font-style: italic;
  }

  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(102, 126, 234, 0.5) !important;
  }

  .btn:active {
    transform: translateY(0);
  }
</style>
