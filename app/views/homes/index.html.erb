<!-- Hero Section with Animation -->
<section class="position-relative overflow-hidden" style="min-height: 100vh; background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #ff6b9d 50%, #ee7a52 100%); display: flex; align-items: center;">
  <!-- Animated Background Elements -->
  <div class="position-absolute" style="top: -100px; left: -100px; width: 500px; height: 500px; background: rgba(255, 255, 255, 0.1); border-radius: 50%; animation: float 6s ease-in-out infinite;"></div>
  <div class="position-absolute" style="bottom: -150px; right: -150px; width: 600px; height: 600px; background: rgba(76, 175, 80, 0.15); border-radius: 50%; animation: float 8s ease-in-out infinite 1s;"></div>
  
  <div class="container-xl position-relative z-1">
    <div class="row align-items-center">
      <!-- Left Side - Hero Text -->
      <div class="col-lg-6 text-white mb-5 mb-lg-0" style="animation: slideInLeft 0.8s ease-out;">
