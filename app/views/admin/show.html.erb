<div class="container-fluid mt-4">
  <div class="row">
    <!-- Sidebar Menu -->
    <%= render 'sidebar_menu' %>

    <!-- Main Content -->
    <div class="col-lg-9">
      <div class="card shadow">
        <div class="card-header bg-light">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">👤 User Details: <%= @user.first_name %> <%= @user.last_name %></h5>
            <div>
              <%= link_to "✏️ Edit", admin_edit_user_path(@user), class: "btn btn-sm btn-primary me-2" %>
              <% if current_user != @user %>
                <%= link_to "🗑️ Delete", admin_delete_user_path(@user), class: "btn btn-sm btn-danger" %>
              <% end %>
            </div>
          </div>
        </div>
        <div class="card-body">
          <!-- User Role -->
          <div class="mb-4 pb-3 border-bottom">
            <h6 class="mb-2">Current Role</h6>
            <p>
              <span class="badge bg-<%= @user.admin? ? 'danger' : @user.manager? ? 'warning' : 'secondary' %> p-2 fs-6">
                <%= @user.admin? ? '👑 Admin' : @user.manager? ? '👔 Manager' : '👤 Regular User' %>
              </span>
            </p>
          </div>

          <!-- Personal Information -->
          <div class="border-bottom pb-3 mb-4">
            <h6 class="mb-3">📋 Personal Information</h6>
            <div class="row">
              <div class="col-md-6">
                <p><strong>Email:</strong> <code><%= @user.email %></code></p>
                <p><strong>Mobile:</strong> <code><%= @user.mobile_no %></code></p>
                <p><strong>Gender:</strong> <%= @user.gender %></p>
              </div>
              <div class="col-md-6">
                <p><strong>Date of Birth:</strong> <%= @user.dob.strftime("%d %B, %Y") if @user.dob %></p>
                <p><strong>Religion:</strong> <%= @user.religion %></p>
                <p><strong>Marital Status:</strong> <%= @user.marital_status %></p>
              </div>
            </div>
          </div>

          <!-- Physical Details -->
          <div class="border-bottom pb-3 mb-4">
            <h6 class="mb-3">💪 Physical Details</h6>
            <div class="row">
              <div class="col-md-6">
                <p><strong>Height:</strong> <%= @user.height %></p>
                <p><strong>Complexion:</strong> <%= @user.complexion %></p>
              </div>
              <div class="col-md-6">
                <p><strong>Mother Tongue:</strong> <%= @user.mother_tongue %></p>
                <p><strong>Caste:</strong> <%= @user.caste %></p>
              </div>
            </div>
          </div>

          <!-- Professional Information -->
          <div class="border-bottom pb-3 mb-4">
            <h6 class="mb-3">💼 Professional Information</h6>
            <div class="row">
              <div class="col-md-6">
                <p><strong>Job:</strong> <%= @user.job || "Not provided" %></p>
                <p><strong>Education:</strong> <%= @user.heighst_education || "Not provided" %></p>
              </div>
              <div class="col-md-6">
                <p><strong>Organization:</strong> <%= @user.organization_name || "Not provided" %></p>
                <p><strong>Income:</strong> <%= @user.annual_income || "Not provided" %></p>
              </div>
            </div>
          </div>

          <!-- Account Information -->
          <div>
            <h6 class="mb-3">🔧 Account Information</h6>
            <p><strong>Member Since:</strong> <%= @user.created_at.strftime("%d %B, %Y") %></p>
            <p><strong>Last Updated:</strong> <%= @user.updated_at.strftime("%d %B, %Y") %></p>
          </div>
        </div>
        <div class="card-footer bg-light">
          <div class="d-flex gap-2">
            <%= link_to "← Back to Users", admin_users_path, class: "btn btn-secondary" %>
            <%= link_to "✏️ Edit User", admin_edit_user_path(@user), class: "btn btn-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
        </div>
      </div>
    </div>
  </div>
</div>
