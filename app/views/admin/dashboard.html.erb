<div class="container-fluid mt-4">
  <div class="row">
    <!-- Sidebar Menu -->
    <%= render 'sidebar_menu' %>

    <!-- Main Content -->
    <div class="col-lg-9">
      <div class="row mb-4">
        <div class="col">
          <% if current_user.admin? %>
            <h2>📊 Admin Dashboard</h2>
            <p class="text-muted">System Overview & Statistics</p>
          <% else %>
            <h2>📊 Manager Dashboard</h2>
            <p class="text-muted">User Management & Overview</p>
          <% end %>
        </div>
      </div>

      <!-- Statistics Cards -->
      <div class="row mb-4">
    <% if current_user.admin? %>
      <!-- Admin-only: Show all statistics -->
      <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 bg-gradient-primary text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title mb-0 opacity-75">Total Users</h6>
                <h2 class="card-text mt-2 mb-0"><%= @total_users %></h2>
              </div>
              <div class="display-6 opacity-25">👥</div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 bg-danger text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title mb-0 opacity-75">Admins</h6>
                <h2 class="card-text mt-2 mb-0"><%= @total_admins %></h2>
              </div>
              <div class="display-6 opacity-25">👑</div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 bg-warning text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title mb-0 opacity-75">Managers</h6>
                <h2 class="card-text mt-2 mb-0"><%= @total_managers %></h2>
              </div>
              <div class="display-6 opacity-25">👔</div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-3 mb-3">
        <div class="card shadow-sm border-0 bg-info text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title mb-0 opacity-75">Regular Users</h6>
                <h2 class="card-text mt-2 mb-0"><%= @total_users_count %></h2>
              </div>
              <div class="display-6 opacity-25">👤</div>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <!-- Manager: Show only total and regular users -->
      <div class="col-md-6 mb-3">
        <div class="card shadow-sm border-0 bg-gradient-primary text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title mb-0 opacity-75">Total Users</h6>
                <h2 class="card-text mt-2 mb-0"><%= @total_users %></h2>
              </div>
              <div class="display-6 opacity-25">👥</div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="col-md-6 mb-3">
        <div class="card shadow-sm border-0 bg-info text-white">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-center">
              <div>
                <h6 class="card-title mb-0 opacity-75">Regular Users</h6>
                <h2 class="card-text mt-2 mb-0"><%= @total_users_count %></h2>
              </div>
              <div class="display-6 opacity-25">👤</div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Quick Actions -->
  <div class="row mb-4">
    <div class="col-lg-12">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
          <h5 class="mb-0">Quick Actions</h5>
        </div>
        <div class="card-body">
          <div class="row">
            <div class="col-md-4 mb-2">
              <%= link_to "📋 Manage Users", admin_users_path, class: "btn btn-outline-primary btn-block w-100" %>
            </div>
            <% if current_user.admin? %>
              <div class="col-md-4 mb-2">
                <%= link_to "👥 View All Users", admin_users_path, class: "btn btn-outline-secondary btn-block w-100" %>
              </div>
              <div class="col-md-4 mb-2">
                <%= link_to "⚙️ System Settings", "#", class: "btn btn-outline-warning btn-block w-100" %>
              </div>
            <% else %>
              <div class="col-md-4 mb-2">
                <%= link_to "👥 View Users", admin_users_path, class: "btn btn-outline-secondary btn-block w-100" %>
              </div>
              <div class="col-md-4 mb-2">
                <%= link_to "🏠 Back to Home", root_path, class: "btn btn-outline-info btn-block w-100" %>
              </div>
            <% end %>
            <% if current_user.admin? %>
              <div class="col-md-12 mt-2">
                <%= link_to "🏠 Back to Home", root_path, class: "btn btn-outline-info btn-block w-100" %>
              </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Recent Users Section -->
  <div class="row">
    <div class="col-lg-12">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-light">
          <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">📅 Recent Users</h5>
            <small class="text-muted">Latest 10 registrations</small>
          </div>
        </div>
        <div class="card-body">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr class="table-light">
                  <th>#</th>
                  <th>Name</th>
                  <th>Email</th>
                  <th>Mobile</th>
                  <th>Gender</th>
                  <th>Role</th>
                  <th>Joined</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody>
                <% @recent_users.each_with_index do |user, index| %>
                  <tr>
                    <td><%= index + 1 %></td>
                    <td>
                      <strong><%= user.first_name %> <%= user.last_name %></strong>
                    </td>
                    <td><%= user.email %></td>
                    <td><code><%= user.mobile_no %></code></td>
                    <td><%= user.gender %></td>
                    <td>
                      <span class="badge bg-<%= user.admin? ? 'danger' : user.manager? ? 'warning' : 'secondary' %>">
                        <%= user.role.titleize %>
                      </span>
                    </td>
                    <td>
                      <small><%= user.created_at.strftime("%d %b %Y") %></small>
                    </td>
                    <td>
                      <%= link_to "View", admin_user_path(user), class: "btn btn-sm btn-outline-primary" %>
                      <%= link_to "Edit", admin_edit_user_path(user), class: "btn btn-sm btn-outline-secondary" %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
          <div class="text-center mt-3">
            <%= link_to "View All Users →", admin_users_path, class: "btn btn-primary" %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
      </div>
    </div>
  </div>
</div>
