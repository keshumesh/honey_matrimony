<!-- Unified Top Navigation Bar - Used in Special Pages -->
<nav class="navbar navbar-expand-lg navbar-dark sticky-top shadow-sm" style="background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);">
  <div class="container-fluid">
    <!-- Brand Logo -->
   
    <!-- Right Side Menu -->
    <div class="ms-auto d-flex align-items-center gap-2">
      <% if logged_in? %>
        <!-- User Menu -->
        <div class="dropdown">
          <button class="btn btn-sm btn-link nav-link text-white dropdown-toggle" type="button" id="userMenu" data-bs-toggle="dropdown">
            <i class="bi bi-person-circle"></i>
            <span class="d-inline-block ms-1" style="font-size: 12px;"><%= current_user.first_name %></span>
          </button>
          <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenu">
            <li><%= link_to "👁️ View Profile", user_path(current_user), class: "dropdown-item" %></li>
            <li><%= link_to "✏️ Edit Profile", edit_user_path(current_user), class: "dropdown-item" %></li>
            <li><hr class="dropdown-divider"></li>
            <li><%= button_to "🚪 Logout", logout_path, method: :delete, class: "dropdown-item" %></li>
          </ul>
        </div>
      <% else %>
        <!-- Guest Menu -->
        <a href="<%= new_session_path %>" class="btn btn-sm btn-outline-light me-2" style="font-size: 12px;">
          <i class="bi bi-box-arrow-in-right"></i> Login
        </a>
        <%= link_to "Sign Up", new_signup_path, class: "btn btn-sm btn-danger" %>
      <% end %>
    </div>
  </div>
</nav>
