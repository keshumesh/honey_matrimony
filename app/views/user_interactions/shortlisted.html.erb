<div class="container mt-5">
  <div class="row">
    <div class="col-lg-10 mx-auto">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-gradient text-white">
          <h4 class="mb-0">
            <i class="bi bi-star-fill"></i> <%= t('my_shortlist') %>
          </h4>
        </div>
        <div class="card-body">
          <% if @interactions.any? %>
            <div class="row">
              <% @interactions.each do |interaction| %>
                <div class="col-md-6 mb-4">
                  <div class="card h-100 shortlist-card border-left border-4 border-warning">
                    <div class="row g-0">
                      <div class="col-md-4">
                        <% if interaction.to_user.avatar.present? %>
                          <%= image_tag interaction.to_user.avatar.url, class: "img-fluid rounded-start", alt: "Profile" %>
                        <% else %>
                          <div class="bg-light d-flex align-items-center justify-content-center h-100">
                            <i class="bi bi-person-circle" style="font-size: 3rem; color: #ccc;"></i>
                          </div>
                        <% end %>
                      </div>
                      <div class="col-md-8">
                        <div class="card-body">
                          <h5 class="card-title"><%= interaction.to_user.first_name %> <%= interaction.to_user.last_name %></h5>
                          <p class="card-text">
                            <small class="text-muted">
                              <%= interaction.to_user.gender %><br/>
                              <%= interaction.to_user.religion %> • <%= interaction.to_user.caste %><br/>
                              <% if interaction.to_user.dob.present? %>
                                Age: <%= ((Date.today - interaction.to_user.dob).to_i / 365.25).round %>
                              <% end %>
                            </small>
                          </p>
                          <div class="d-flex gap-2 mt-2">
                            <%= link_to browse_profile_user_path(interaction.to_user), class: "btn btn-sm btn-info" do %>
                              <i class="bi bi-eye"></i> <%= t('view') %>
                            <% end %>
                            <%= link_to browse_profile_user_path(interaction.to_user), method: :delete, data: { confirm: t('are_you_sure') }, class: "btn btn-sm btn-danger" do %>
                              <i class="bi bi-trash"></i>
                            <% end %>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <div class="alert alert-info" role="alert">
              <i class="bi bi-info-circle"></i> <%= t('no_shortlist_yet') %>
            </div>
          <% end %>
        </div>
      </div>

      <div class="mt-4">
        <%= link_to t('browse_profiles'), users_path, class: "btn btn-primary" %>
        <%= link_to t('back_to_home'), user_dashboard_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>

<style>
  .shortlist-card {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .shortlist-card:hover {
    transform: translateX(5px);
    box-shadow: 0 4px 15px rgba(255, 193, 7, 0.2);
  }
  .bg-gradient {
    background: linear-gradient(135deg, #ffd89b 0%, #19547b 100%);
  }
</style>
