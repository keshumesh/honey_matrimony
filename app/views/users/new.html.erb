                    <div class="mb-3">
                      <%= form.label :first_name, "#{t('first_name')} *" %>
                      <%= form.text_field :first_name, class: "form-control", placeholder: t('enter_first_name'), required: true %>
                    </div>
                  </div>
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :last_name, "#{t('last_name')} *" %>
                      <%= form.text_field :last_name, class: "form-control", placeholder: t('enter_last_name'), required: true %>
                    </div>
                  </div>
                </div>

                <div class="row">
                  <div class="col-md-6">
                    <div class="mb-3">
                      <%= form.label :gender, "#{t('gender')} *" %>
                      <%= form.select :gender, [["Male", "Male"], ["Female", "Female"]], 
