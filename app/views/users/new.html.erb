          <p class="text-center text-muted mb-4"><%= t('join_simple_steps') %></p>

          <% if @user.errors.any? %>
            <div class="alert alert-danger alert-dismissible fade show">
              <h5><%= pluralize(@user.errors.count, t('error')) %> <%= t('errors') %> prohibited this profile from being saved:</h5>
              <ul class="mb-0">
                <% @user.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
              <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
          <% end %>

          <!-- Progress Indicator -->
          <div class="mb-4">
            <div class="progress" style="height: 8px;">
              <div class="progress-bar" role="progressbar" style="width: 33%" aria-valuenow="33" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
            <div class="row text-center mt-3 small">
              <div class="col">
                <strong class="step-indicator active-step"><%= t('step_1_create') %></strong>
              </div>
              <div class="col">
                <strong class="step-indicator"><%= t('step_2_details') %></strong>
              </div>
              <div class="col">
                <strong class="step-indicator"><%= t('step_3_account') %></strong>
              </div>
