                  <div class="mb-3">
                    <%= form.label :blood_group, "Blood Group" %>
                    <%= form.select :blood_group, ["O+", "O-", "A+", "A-", "B+", "B-", "AB+", "AB-", "Not Sure"], 
                        { include_blank: "Select..." }, class: "form-select" %>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="mb-3">
                    <%= form.label :extra_phone_number, "Additional Phone Number" %>
                    <%= form.text_field :extra_phone_number, class: "form-control", placeholder: "10 digit number" %>
                  </div>
                </div>
              </div>

              <div class="row">
                <div class="col-md-6">
                  <div class="mb-3">
                    <%= form.label :maternal_surname, "Maternal Surname" %>
                    <%= form.text_field :maternal_surname, class: "form-control", placeholder: "Mother's surname" %>
                  </div>
                </div>
              </div>
            </div>

            <!-- Credentials Section -->
            <div class="border-bottom pb-4 mb-4">
              <h5 class="mb-3"><i class="bi bi-lock"></i> Account Credentials</h5>
              
              <div class="mb-3">
                <%= form.label :email, "Email Address *" %>
                <%= form.email_field :email, class: "form-control", placeholder: "Enter your email", required: true %>
              </div>

              <div class="row">
                <div class="col-md-6">
                  <div class="mb-3">
                    <%= form.label :password, "Password *" %>
                    <%= form.password_field :password, class: "form-control", placeholder: "Minimum 6 characters", required: true %>
                  </div>
                </div>
                <div class="col-md-6">
                  <div class="mb-3">
                    <%= form.label :password_confirmation, "Confirm Password *" %>
                    <%= form.password_field :password_confirmation, class: "form-control", placeholder: "Confirm password", required: true %>
                  </div>
                </div>
              </div>
            </div>

            <div class="d-grid gap-2">
              <%= form.submit "Create Account", class: "btn btn-primary btn-lg" %>
            </div>
          <% end %>

          <hr class="my-4">

          <div class="text-center">
            <p>Already have an account? <%= link_to "Login here", login_path %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .matrimony-required {
    color: #dc3545;
    font-weight: bold;
  }
  
  .matrimony-section-disabled {
    opacity: 0.6;
    pointer-events: none;
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const roleSelect = document.getElementById('user_role');
  const matrimonySection = document.querySelector('[data-matrimony-section="true"]');
  const matrimonyFields = document.querySelectorAll('[data-matrimony="true"]');
  const matrimonyRequiredSpans = document.querySelectorAll('.matrimony-required');
  
  function updateFieldsRequirement() {
    const isAdmin = roleSelect && roleSelect.value === 'admin';
    const roleSelected = roleSelect && roleSelect.value && roleSelect.value !== '';
    
    if (matrimonySection) {
      if (isAdmin) {
        matrimonySection.classList.add('matrimony-section-disabled');
      } else {
        matrimonySection.classList.remove('matrimony-section-disabled');
      }
    }
    
    matrimonyFields.forEach(field => {
      // Only set required if a role has been selected AND it's not admin
      if (roleSelected && !isAdmin) {
        field.setAttribute('required', 'required');
      } else {
        field.removeAttribute('required');
      }
    });
    
    matrimonyRequiredSpans.forEach(span => {
      if (roleSelected && isAdmin) {
        span.style.display = 'none';
      } else if (roleSelected && !isAdmin) {
        span.style.display = 'inline';
      } else {
        span.style.display = 'none';
      }
    });
  }
  
  if (roleSelect) {
    roleSelect.addEventListener('change', updateFieldsRequirement);
    // Don't call updateFieldsRequirement() on initial load - let user select role first
  }
});
</script>
