<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white">
          <h3 class="card-title mb-0"><i class="bi bi-image"></i> Import Users from Image</h3>
        </div>
        <div class="card-body">
          <div class="alert alert-info mb-4" role="alert">
            <h5 class="alert-heading">📸 Image to User Import (with OCR)</h5>
            <p>Upload an image of a profile document or user data. The system will automatically extract text using OCR and create users.</p>
          </div>

          <!-- Requirements -->
          <div class="card mb-4 border-warning">
            <div class="card-header bg-warning">
              <h6 class="card-title mb-0"><i class="bi bi-exclamation-triangle"></i> Before You Start</h6>
            </div>
            <div class="card-body">
              <p><strong>Tesseract OCR must be installed on your system.</strong></p>
              
              <h6 class="mt-3">Windows Installation:</h6>
              <pre class="bg-light p-3 rounded"><code>choco install tesseract</code></pre>
              <p>Or download installer from: <a href="https://github.com/UB-Mannheim/tesseract/wiki" target="_blank">https://github.com/UB-Mannheim/tesseract/wiki</a></p>
              
              <h6 class="mt-3">Linux Installation:</h6>
              <pre class="bg-light p-3 rounded"><code>sudo apt-get install tesseract-ocr</code></pre>
              
              <h6 class="mt-3">macOS Installation:</h6>
              <pre class="bg-light p-3 rounded"><code>brew install tesseract</code></pre>
            </div>
          </div>

          <!-- Image Requirements -->
          <div class="card mb-4 border-primary">
            <div class="card-header bg-primary text-white">
              <h6 class="card-title mb-0"><i class="bi bi-card-image"></i> Supported Image Formats</h6>
            </div>
            <div class="card-body">
              <p><strong>File Types:</strong> PNG, JPG, JPEG, TIFF, BMP, GIF, WEBP</p>
              <p><strong>Recommended Resolution:</strong> 300+ DPI for best accuracy</p>
              <p><strong>Max File Size:</strong> 10 MB</p>
              
              <h6 class="mt-3">Tips for Best OCR Results:</h6>
              <ul>
                <li>✓ Use clear, high-contrast images</li>
                <li>✓ Ensure good lighting (avoid shadows and glare)</li>
                <li>✓ Keep text straight and upright</li>
                <li>✓ Black text on white/light background works best</li>
                <li>✓ Avoid handwritten text (printed text works better)</li>
                <li>✓ Minimize background patterns and watermarks</li>
              </ul>
            </div>
          </div>

          <!-- Matrimony Profile Format -->
          <div class="card mb-4 border-success">
            <div class="card-header bg-success text-white">
              <h6 class="card-title mb-0">Format 1: Matrimony Profiles</h6>
            </div>
            <div class="card-body">
              <p><strong>Image should contain:</strong></p>
              <ul class="mb-2">
                <li>Name</li>
                <li>Date of Birth</li>
                <li>Caste, Religion, Mother Tongue</li>
                <li>Complexion, Height</li>
                <li>Education, Occupation</li>
                <li>Address, Phone Number</li>
              </ul>
              <p class="text-muted small">
                <i class="bi bi-info-circle"></i> Auto-generated email: firstname.lastname@matrimony.local
                <br>
                <i class="bi bi-info-circle"></i> Temporary password: TempPass@2026
              </p>
            </div>
          </div>

          <!-- CSV Format -->
          <div class="card mb-4 border-warning">
            <div class="card-header bg-warning">
              <h6 class="card-title mb-0">Format 2: CSV Admin/Manager Data</h6>
            </div>
            <div class="card-body">
              <p><strong>Image can contain spreadsheet or table with:</strong></p>
              <pre class="bg-light p-3 rounded"><code>First Name: John, Last Name: Doe, Email: john@example.com, Mobile: 9876543210, Password: SecurePass123, Role: admin</code></pre>
              
              <p><strong>Or pipe-separated:</strong></p>
              <pre class="bg-light p-3 rounded"><code>John | Doe | john@example.com | 9876543210 | SecurePass123 | admin</code></pre>
            </div>
          </div>

          <hr class="my-4">

          <%= form_with url: process_image_users_path, local: true, multipart: true do %>
            <div class="mb-3">
              <label for="image_file" class="form-label">Option 1: Upload Image File (if Tesseract OCR installed)</label>
              <input type="file" class="form-control" id="image_file" name="image_file" 
                     accept=".png,.jpg,.jpeg,.tiff,.tif,.bmp,.gif,.webp">
              <small class="form-text text-muted">
                Upload an image containing profile or user data. OCR will extract text automatically if Tesseract is installed.
              </small>
            </div>

            <div class="mb-3">
              <label for="extracted_text" class="form-label">Option 2: Paste Extracted Text</label>
              <textarea class="form-control" id="extracted_text" name="extracted_text" 
                        rows="8" placeholder="If you don't have Tesseract OCR installed, paste the extracted text here instead..."></textarea>
              <small class="form-text text-muted">
                Either upload an image OR paste text - at least one is required
              </small>
            </div>

            <div class="d-flex gap-2">
              <%= submit_tag "Extract Text & Import Users", class: "btn btn-success" %>
              <%= link_to "Cancel", users_path, class: "btn btn-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
