<div class="container-fluid mt-5">
  <!-- Search Filter Section -->
  <div class="row mb-4">
    <div class="col">
      <div class="card shadow-sm border-0">
        <div class="card-body">
          <h5 class="card-title mb-3"><i class="bi bi-funnel"></i> Search & Filter</h5>
          <%= form_with url: users_path, method: :get, local: true, class: "row g-3" do %>
            <div class="col-md-3">
              <%= text_field_tag :search_name, params[:search_name], placeholder: "Search by name...", class: "form-control" %>
            </div>
            <%# Gender filter for admin and manager %>
            <% if current_user&.admin? || current_user&.manager? %>
              <div class="col-md-2">
                <%= select_tag :search_gender, options_for_select(["Male", "Female"], params[:search_gender]), include_blank: "All Genders", class: "form-select" %>
              </div>
            <% end %> 
            <div class="col-md-2">
              <%= number_field_tag :min_age, params[:min_age], placeholder: "Min Age", class: "form-control", min: 18, max: 100 %>
            </div>
            <div class="col-md-2">
              <%= number_field_tag :max_age, params[:max_age], placeholder: "Max Age", class: "form-control", min: 18, max: 100 %>
            </div>
            <div class="col-md-3">
              <%= text_field_tag :search_address, params[:search_address], placeholder: "Search by address...", class: "form-control" %>
            </div>
            <div class="col-md-2 d-flex gap-2">
              <%= submit_tag "Search", class: "btn btn-primary w-100" %>
              <% if params[:search_name].present? || params[:search_gender].present? || params[:min_age].present? || params[:max_age].present? || params[:search_address].present? %>
                <%= link_to "Clear", users_path, class: "btn btn-outline-secondary w-100" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col">
      <h2>Browse Matrimony Profiles</h2>
    </div>
    <% if current_user&.admin? || current_user&.manager? %>
      <div class="col text-end d-flex gap-2 justify-content-end flex-wrap">
        <%= link_to "+ Create Profile", new_user_path, class: "btn btn-primary btn-lg" %>
        <% if current_user&.admin? %>
          <%= link_to "<i class='bi bi-file-pdf'></i> Import PDF", import_pdf_users_path, class: "btn btn-success btn-lg" %>
        <% end %>
        <% if current_user&.admin? || current_user&.manager? %>
          <%= link_to "<i class='bi bi-image'></i> Import Image", import_image_users_path, class: "btn btn-info btn-lg" %>
        <% end %>
      </div>
    <% end %>
  </div>

  <% if @users.any? %>
    <div class="row">
      <% @users.each do |user| %>
        <div class="col-lg-3 col-md-4 col-sm-6 mb-3">
          <div class="card h-100 shadow-sm border-0" style="transition: all 0.3s ease; border-radius: 12px; overflow: hidden;">
            <style>
              .profile-card:hover {
                box-shadow: 0 8px 20px rgba(0,0,0,0.15) !important;
                transform: translateY(-5px);
              }
              .profile-card {
                transition: all 0.3s ease;
              }
            </style>
            <div class="card profile-card" style="border-radius: 12px; overflow: hidden;">
              <div class="card-body p-3">
                <!-- Avatar -->
                <div class="text-center mb-2">
                  <% if user&.avatar&.present? %>
                    <img src="<%= user.avatar.url(:thumb) %>" alt="<%= user.first_name %>" class="rounded-circle" style="width: 70px; height: 70px; object-fit: cover; border: 3px solid #ff6b9d; box-shadow: 0 2px 8px rgba(255,107,157,0.2);">
                  <% else %>
                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto" style="width: 70px; height: 70px; border: 3px solid #dee2e6; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                      <i class="bi bi-person" style="font-size: 36px; color: #999;"></i>
                    </div>
                  <% end %>
                </div>

                <!-- Header -->
                <div class="mb-2 text-center">
                  <h6 class="card-title mb-1" style="font-weight: 600; color: #333; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                    <%= user.first_name %> <%= user.last_name %>
                  </h6>
                  <div style="font-size: 11px;">
                    <% if user.dob %>
                      <span class="badge bg-danger" style="font-size: 10px;">
                        <%= ((Date.today - user.dob.to_date) / 365.25).round %> yrs
                      </span>
                    <% end %>
                    <% if user.gender %>
                      <span class="badge bg-info" style="font-size: 10px;"><%= user.gender.slice(0,1) %></span>
                    <% end %>
                  </div>
                </div>

                <!-- Quick Info -->
                <div style="font-size: 11px; color: #666; line-height: 1.4;">
                  <% if user.religion %>
                    <p class="mb-1"><i class="bi bi-heart" style="color: #ff6b9d; font-size: 10px;"></i> <strong><%= user.religion %></strong></p>
                  <% end %>
                  <% if user.job %>
                    <p class="mb-1"><i class="bi bi-briefcase" style="color: #4CAF50; font-size: 10px;"></i> <%= truncate(user.job, length: 20) %></p>
                  <% end %>
                  <% if user.address %>
                    <p class="mb-1"><i class="bi bi-geo-alt" style="color: #2196F3; font-size: 10px;"></i> <%= truncate(user.address, length: 20) %></p>
                  <% end %>
                </div>

                <!-- Gallery Photos -->
                <% if user.gallery_photos.any? %>
                  <div class="mt-2 pt-2 border-top">
                    <div style="display: flex; gap: 4px; overflow-x: auto;">
                      <% user.gallery_photos.first(3).each do |photo| %>
                        <img src="<%= photo %>" alt="Gallery" class="rounded" style="width: 35px; height: 35px; object-fit: cover; flex-shrink: 0; border: 1px solid #eee;">
                      <% end %>
                      <% if user.gallery_photos.length > 3 %>
                        <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width: 35px; height: 35px; font-size: 10px; flex-shrink: 0; border: 1px solid #eee;">
                          +<%= user.gallery_photos.length - 3 %>
                        </div>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>

              <!-- Footer Button -->
              <div class="card-footer bg-white border-top p-2" style="background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);">
                <% if current_user&.admin? || current_user&.manager? %>
                  <%= link_to "View", user_path(user), class: "btn btn-sm btn-outline-primary w-100", style: "font-size: 12px; padding: 4px;" %>
                <% else %>
                  <%= link_to "View", browse_profile_user_path(user), class: "btn btn-sm btn-outline-primary w-100", style: "font-size: 12px; padding: 4px;" %>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="alert alert-info text-center py-5">
      <h5>No profiles found yet</h5>
      <p>Be the first to create a matrimony profile!</p>
      <%= link_to "Create Profile Now", new_user_path, class: "btn btn-primary mt-3" %>
    </div>
  <% end %>
</div>
