<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-10">
      <div class="card shadow-sm border-0">
        <div class="card-header bg-primary text-white">
          <h3 class="card-title mb-0"><i class="bi bi-file-pdf"></i> Import Users from PDF</h3>
        </div>
        <div class="card-body">
          <div class="alert alert-info mb-4" role="alert">
            <h5 class="alert-heading">📋 Supported PDF Formats</h5>
            <p>The import system supports two formats:</p>
          </div>

          <!-- Format 1: Matrimony Profile Format -->
          <div class="card mb-4 border-success">
            <div class="card-header bg-success text-white">
              <h6 class="card-title mb-0">Format 1: Matrimony Profiles</h6>
            </div>
            <div class="card-body">
              <p><strong>Best for:</strong> Importing existing matrimony profile PDFs with personal and family details</p>
              <p>The system will extract the following fields from the PDF:</p>
              <ul class="mb-2">
                <li><strong>Name:</strong> User's full name (required)</li>
                <li><strong>Date of Birth:</strong> Birth date (optional)</li>
                <li><strong>Caste:</strong> Caste information (optional)</li>
                <li><strong>Complexion:</strong> Complexion type (optional)</li>
                <li><strong>Height:</strong> Height in feet/inches (optional)</li>
                <li><strong>Education:</strong> Educational details (optional)</li>
                <li><strong>Occupation:</strong> Job/occupation (optional)</li>
                <li><strong>Address:</strong> Location/address (optional)</li>
                <li><strong>Phone/Mobile:</strong> Contact number (optional)</li>
                <li><strong>Gender:</strong> Male/Female (optional)</li>
                <li><strong>Religion:</strong> Religion (optional)</li>
                <li><strong>Mother Tongue:</strong> Language (optional)</li>
              </ul>
              <p class="text-muted small">
                <i class="bi bi-info-circle"></i> Auto-generated email: firstname.lastname@matrimony.local
                <br>
                <i class="bi bi-info-circle"></i> Temporary password: TempPass@2026
              </p>
            </div>
          </div>

          <!-- Format 2: CSV Format -->
          <div class="card mb-4 border-warning">
            <div class="card-header bg-warning">
              <h6 class="card-title mb-0">Format 2: CSV for Admin/Manager Import</h6>
            </div>
            <div class="card-body">
              <p><strong>Best for:</strong> Bulk importing admin and manager accounts</p>
              
              <h6 class="mt-3">Comma-separated with colons:</h6>
              <pre class="bg-light p-3 rounded"><code>First Name: John, Last Name: Doe, Email: john@example.com, Mobile: 9876543210, Password: SecurePass123, Role: admin
First Name: Jane, Last Name: Smith, Email: jane@example.com, Mobile: 9876543211, Password: SecurePass123, Role: manager</code></pre>
              
              <h6 class="mt-3">Pipe-separated values:</h6>
              <pre class="bg-light p-3 rounded"><code>John | Doe | john@example.com | 9876543210 | SecurePass123 | admin
Jane | Smith | jane@example.com | 9876543211 | SecurePass123 | manager</code></pre>
              
              <h6 class="mt-3">Required Fields for CSV:</h6>
              <ul>
                <li><strong>First Name:</strong> User's first name (required)</li>
                <li><strong>Email:</strong> Valid email address (required)</li>
                <li><strong>Password:</strong> At least 6 characters (required)</li>
                <li><strong>Role:</strong> "admin" or "manager" (required)</li>
                <li><strong>Last Name:</strong> User's last name (optional, defaults to "User")</li>
                <li><strong>Mobile:</strong> 10-digit mobile number (optional, defaults to "0000000000")</li>
              </ul>
            </div>
          </div>

          <hr class="my-4">

          <%= form_with url: process_pdf_users_path, local: true, multipart: true do %>
            <div class="mb-3">
              <label for="pdf_file" class="form-label">Select PDF File</label>
              <input type="file" class="form-control" id="pdf_file" name="pdf_file" accept=".pdf" required>
              <small class="form-text text-muted">Select a PDF file containing user data in either format</small>
            </div>

            <div class="d-flex gap-2">
              <%= submit_tag "Import Users", class: "btn btn-primary" %>
              <%= link_to "Cancel", users_path, class: "btn btn-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
